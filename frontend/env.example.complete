# =============================================================================
# Neural Chat Interface - Configuration Environment
# =============================================================================
# 
# Ce fichier contient toutes les variables d'environnement nécessaires.
# 
# IMPORTANT: 
# - Copiez ce fichier en .env avant de démarrer: cp .env.example .env
# - Ne commitez JAMAIS le fichier .env (il est dans .gitignore)
# - Les variables avec préfixe VITE_ sont accessibles côté client
# 
# =============================================================================

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------

# URL de base de votre backend API
# Exemples:
#   - Développement local:    http://localhost:8000
#   - Production:             https://api.votre-domaine.com
#   - Docker:                 http://backend:8000
VITE_API_BASE_URL=http://localhost:8000

# Timeout des requêtes API (en millisecondes)
# Par défaut: 120000 (120 secondes)
# VITE_API_TIMEOUT=120000

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------

# Nom de l'application (affiché dans le titre)
# VITE_APP_NAME=Neural Chat Interface

# Version de l'application
# VITE_APP_VERSION=1.0.0

# Environnement (development, staging, production)
# VITE_ENV=development

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------

# Activer/désactiver le mode debug
# VITE_DEBUG_MODE=false

# Afficher les logs détaillés dans la console
# VITE_VERBOSE_LOGGING=false

# Activer le mode démonstration (avec données fictives)
# VITE_DEMO_MODE=false

# -----------------------------------------------------------------------------
# UI Customization
# -----------------------------------------------------------------------------

# Couleur primaire (format hexadécimal)
# VITE_PRIMARY_COLOR=#8b5cf6

# Couleur secondaire
# VITE_SECONDARY_COLOR=#6366f1

# Afficher le logo personnalisé
# VITE_SHOW_LOGO=true

# URL du logo (si VITE_SHOW_LOGO=true)
# VITE_LOGO_URL=/logo.png

# -----------------------------------------------------------------------------
# Analytics & Monitoring (Optionnel)
# -----------------------------------------------------------------------------

# Google Analytics ID
# VITE_GA_ID=

# Sentry DSN (pour le monitoring des erreurs)
# VITE_SENTRY_DSN=

# -----------------------------------------------------------------------------
# Advanced Configuration
# -----------------------------------------------------------------------------

# Nombre maximum de messages dans l'historique
# VITE_MAX_MESSAGES=100

# Délai avant auto-scroll (en ms)
# VITE_AUTO_SCROLL_DELAY=300

# Activer le cache des réponses
# VITE_ENABLE_CACHE=false

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------

# Clé API (si votre backend nécessite une authentification)
# ATTENTION: Ne jamais exposer de vraies clés API côté client !
# Utilisez plutôt un système d'authentification via cookie/token
# VITE_API_KEY=

# CORS - Domaines autorisés (séparés par des virgules)
# VITE_ALLOWED_ORIGINS=http://localhost:3000,https://votre-domaine.com

# -----------------------------------------------------------------------------
# Development Only
# -----------------------------------------------------------------------------

# Port du serveur de développement Vite
# (configuré aussi dans vite.config.js)
# VITE_DEV_PORT=3000

# Ouvrir automatiquement le navigateur au démarrage
# VITE_AUTO_OPEN=true

# Hot Module Replacement activé
# VITE_HMR=true
